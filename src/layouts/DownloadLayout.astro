---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import DownloadTabs from "@/components/DownloadTabs.astro";
import DownloadCards from "@/components/DownloadCards.astro";
import { getDownloadData, type PlatformKey } from "@/data/downloads";
import { site } from "@/data/site";
interface Props { platform: PlatformKey; title: string; description: string; }
const { platform, title, description } = Astro.props;
const data = await getDownloadData();
const first = data.platforms[platform][0];
const structuredData = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: site.name, applicationCategory: "GameApplication", operatingSystem: title, ...(data.version ? { softwareVersion: data.version } : {}), license: site.repository + "/blob/main/LICENSE", ...(first ? { downloadUrl: first.href } : {}) };
---
<BaseLayout title={"Download for " + title} description={description} structuredData={structuredData}>
  <PageHero eyebrow={data.version ? "Refract " + data.version : "Official downloads"} title={"Refract for " + title} description={description} compact />
  <div class="narrow download-content">
    <DownloadTabs active={platform} />
    {data.platforms[platform].length ? <DownloadCards items={data.platforms[platform]} /> : <p class="status-message">An installer for this platform is currently unavailable. <a href={data.releaseUrl}>Check the official releases page.</a></p>}
    <p class="data-note">{data.releasedAt && "Released " + data.releasedAt + ". "}Installer information checked at build time. <a href={data.releaseUrl}>Release notes and all assets</a>.</p>
    <section class="surface instructions prose"><slot /></section>
  </div>
</BaseLayout>
<style>
  .download-content { padding-bottom: 6rem; }
  .instructions { max-width: none; margin-top: 2rem; padding: clamp(1.25rem, 4vw, 2.3rem); }
  .instructions :global(h2) { margin-top: 0; }
</style>
