---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LauncherShowcase from "@/components/LauncherShowcase.astro";
import MinecraftSkin from "@/components/MinecraftSkin.astro";
import ModrinthCloud from "@/components/ModrinthCloud.astro";
import FeaturePreview from "@/components/FeaturePreview.astro";
import PlatformDownloads from "@/components/PlatformDownloads.astro";
import { ArrowDownToLine, ArrowUpRight, ArrowRight, Coffee, PackageOpen, Star, GitFork, Blocks, Paintbrush, Library, CodeXml, Gamepad2, Check, ChevronDown } from "@/components/icons";
import { getDownloadData } from "@/data/downloads";
import { getProjectData } from "@/data/project";
import { getDiscordData } from "@/data/discord";
import { site } from "@/data/site";
import "@/styles/launcher-home.css";
const [downloads, project, discord] = await Promise.all([getDownloadData(), getProjectData(), getDiscordData()]);
const appData = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: site.name, description: site.description, applicationCategory: "GameApplication", operatingSystem: "Windows, macOS, Linux", ...(downloads.version ? { softwareVersion: downloads.version } : {}), license: site.repository + "/blob/main/LICENSE", downloadUrl: site.url + "/download/", offers: { "@type": "Offer", price: "0", priceCurrency: "USD" } };
const number = (value: number | null) => value === null ? "Unavailable" : value.toLocaleString("en-US");
const metrics = [
  {key:'stars',value:number(project.stars),label:'GitHub stars',icon:Star},
  {key:'forks',value:number(project.forks),label:'Public forks',icon:GitFork},
  {key:'downloads',value:number(project.totalDownloads),label:'Release downloads',icon:ArrowDownToLine},
  {key:'version',value:downloads.version?`v${downloads.version}`:'Unavailable',label:'Latest release',icon:PackageOpen}
];
const questions = [
  ['Is Refract free?', 'Yes. Refract is free, open-source software under GPL-3.0. You can read the code, report issues, and contribute on GitHub.'],
  ['Do I need to own Minecraft?', 'Normal authenticated play requires a Minecraft Java Edition license. Sign in with your Microsoft account to verify ownership and play.'],
  ['Can I bring my existing instances?', 'Refract can discover, link, or copy instances from supported launchers, including Prism, MultiMC, Modrinth App, ATLauncher, CurseForge, and GDLauncher.'],
  ['Which mod loaders are supported?', 'Use Vanilla, Fabric, Forge, NeoForge, or Quilt. Each instance keeps its own Minecraft version, loader, mods, and settings.'],
  ['Do I need to install Java first?', 'Refract discovers installed Java runtimes and can download a compatible runtime for your setup. You can also choose a custom Java executable.'],
  ['Where can I get help?', 'Start with the installation guides and troubleshooting pages in the Wiki. Join the Refract Discord to ask the community, or report a reproducible bug on GitHub.']
];
---
<BaseLayout title={site.name} description="Refract is a free, open-source Minecraft launcher. Organize instances, discover mods and modpacks, and manage Java on Windows, macOS, and Linux." structuredData={appData} editPath="src/pages/index.astro" bodyClass="pixel-home">
  <div class="landing-sky">
    <div class="sky-pixels" aria-hidden="true">{Array.from({length:14},(_,i)=><i style={`--i:${i};left:${(i*31+7)%100}%;top:${(i*19+8)%90}%`}></i>)}</div>
    <section class="home-hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="hero-brand"><img src="/icons/refract-iris.svg" width="80" height="80" alt="" /><h1 id="hero-title">REFRACT<span>LAUNCHER</span></h1></div>
        <p class="hero-tagline">Minecraft, with your<br/><em>mods and worlds together.</em></p>
        <p class="hero-description">A free, open-source launcher for Windows, macOS, and Linux.</p>
        <div class="hero-actions"><a class="pixel-button lime hero-download" href="/download/" data-os-download><ArrowDownToLine size={24}/><span>Download Refract</span></a></div>
        <div class="hero-secondary">
          <a class="pixel-button charcoal" href={site.repository}><CodeXml size={22}/><span>View source<small>GitHub repository</small></span></a>
          <a class="pixel-button violet" href="#features"><Gamepad2 size={22}/><span>See features<small>Explore the launcher</small></span></a>
        </div>
        <a href="#download" class="hero-platforms">Windows, macOS & Linux <ArrowRight size={14}/></a>
      </div>
      <LauncherShowcase />
    </section>
    <nav class="feature-shortcuts container" aria-label="Explore launcher features">
      <a href="#features" class="shortcut-green"><Blocks size={17}/> Mods & modpacks</a>
      <a href="#personalization" class="shortcut-pink"><Paintbrush size={17}/> Make it yours</a>
      <a href="#instances" class="shortcut-blue"><Library size={17}/> Your worlds</a>
      <a href="#runtime" class="shortcut-orange"><Coffee size={17}/> Easy setup</a>
      <a href="#community" class="shortcut-purple"><CodeXml size={17}/> Open source</a>
    </nav>
  </div>

  <div class="landing-panels container">
    <section class="game-panel install-panel" id="features" aria-labelledby="features-title">
      <ModrinthCloud />
      <div class="panel-split install-demo">
        <div class="panel-copy"><h3>Find a pack.<br/>Install and play.</h3><p>Browse Modrinth, CurseForge, and FTB inside Refract. Install a pack into its own instance and keep your worlds organized.</p><ul class="check-list"><li><Check size={17}/> Pick a pack and its version</li><li><Check size={17}/> Keep dependencies together</li><li><Check size={17}/> Launch from your library</li></ul><a class="pixel-button cream" href="/wiki/getting-started/content/">Modpack install guide <ArrowRight size={17}/></a></div>
        <FeaturePreview image="library" tour="modpacks" alt="Refract modpack browsing and Vanilla Perfected details" />
      </div>
      <p class="panel-fineprint">CurseForge requires an API key. Some projects require a download from the author’s page. <a href="/wiki/getting-started/content/">How it works</a></p>
    </section>

    <section class="game-panel customize-panel" id="personalization" aria-labelledby="customize-title">
      <header class="panel-heading"><h2 id="customize-title">A little more <span>you.</span></h2><p>Preview your skin and customize the launcher’s appearance.</p></header>
      <div class="customize-grid">
        <div class="character-showcase"><MinecraftSkin/></div>
        <div class="customize-content"><div class="panel-copy"><h3>Choose a theme. Make it yours.</h3><p>Choose your accent color, switch themes, or use your own background. Preview a Minecraft skin here by dragging the model or choosing a PNG.</p></div><FeaturePreview image="settings" tour="settings" alt="Refract settings, theme selection, and custom background"/><a class="text-link" href="/features/#personalization">See customization tools <ArrowRight size={17}/></a></div>
      </div>
    </section>

    <section class="game-panel library-panel" id="instances" aria-labelledby="library-title">
      <header class="panel-heading"><h2 id="library-title">Every world.<br class="mobile-only"/> <span>Its own home.</span></h2><p>Keep each modpack’s versions, mods, and saves separate.</p></header>
      <div class="panel-split library-demo"><FeaturePreview image="library" tour="library" alt="Refract instance content, mods and updates"/><div class="panel-copy"><h3>Switch packs.<br/>Keep your saves.</h3><p>Keep Minecraft versions, mods, and saves separate. Pin your favorites, group your instances, and get back to the world you left.</p><ul class="check-list"><li><Check size={17}/> Import your existing instances</li><li><Check size={17}/> Enable, disable, and update mods</li><li><Check size={17}/> Export world backups as ZIP files</li></ul><a class="pixel-button cream" href="/wiki/getting-started/importing/">Import your instances <ArrowRight size={17}/></a></div></div>
      <div class="loader-line"><span>Vanilla or modded. Your choice.</span>{[{name:'Fabric',file:'fabric.png'},{name:'Forge',file:'forge.png'},{name:'NeoForge',file:'neoforge.png'},{name:'Quilt',file:'quilt.png'}].map(loader=><span><img src={`/icons/ecosystem/${loader.file}`} width="25" height="25" loading="lazy" alt=""/>{loader.name}</span>)}</div>
    </section>

    <section class="utility-section" id="runtime" aria-label="Runtime and mod management">
      <article class="utility-card runtime-card"><Coffee size={34}/><h2>Java, <span>set up for you.</span></h2><p>Refract finds or downloads a compatible Java runtime. Tune memory and launch settings when you need more control.</p><a class="text-link" href="/wiki/help/java-and-launching/">Java & launch settings <ArrowRight size={17}/></a><div class="runtime-visual" aria-hidden="true"><span class="runtime-block"><Coffee size={32}/></span><span>Choose your world<strong>We’ll find its runtime.</strong></span><Check size={22}/></div></article>
      <article class="utility-card content-card"><PackageOpen size={34}/><h2>Find compatible mods.</h2><p>Find mods for your version, save mod profiles, and keep your favorite additions together.</p><a class="text-link" href="/features/#content">Explore content tools <ArrowRight size={17}/></a><div class="mini-demo"><FeaturePreview image="browse" tour="browse" alt="Browse compatible mods inside Refract"/></div></article>
    </section>

    <section class="game-panel community-section" id="community" aria-labelledby="community-title">
      <header class="panel-heading"><CodeXml size={38}/><h2 id="community-title">Open source.<br class="mobile-only"/> <span>Open possibilities.</span></h2><p>Made by people who play. Built for people like you.</p></header>
      <dl class="github-metrics">{metrics.map(metric=><div><dt><metric.icon size={15}/>{metric.label}</dt><dd data-metric={metric.key}>{metric.value}</dd></div>)}</dl>
      <div class="community-actions"><a class="pixel-button cream" href={site.repository}>Explore the code <ArrowUpRight size={17}/></a><span>Free software. GPL-3.0.</span></div>
      <p class="metrics-note" data-github-status>GitHub snapshot from {new Date(project.fetchedAt).toLocaleDateString("en-US",{timeZone:"UTC",month:"short",day:"numeric",year:"numeric"})}. Downloads count release assets, including updater files, not unique players.</p>
      <div class="discord-panel"><img src="/icons/discord.svg" width="40" height="40" alt="" loading="lazy"/><div><h3>Join the Refract community.</h3><p>Share your setup, ask a question, or help shape Refract.</p><span class="discord-info" data-discord-name>{discord.name}</span><span class="discord-info" data-discord-counts>{discord.onlineCount!==null?`${number(discord.onlineCount)} online${discord.memberCount!==null?` / ${number(discord.memberCount)} members`:''}`:'Join the community'}</span><span data-discord-status class="sr-only">Discord snapshot from {discord.fetchedAt}</span></div><a class="pixel-button violet" href={site.discord}>Join Discord <ArrowUpRight size={17}/></a></div>
    </section>
  </div>

  <section class="downloads-section container" id="download" aria-labelledby="download-title"><header class="panel-heading"><h2 id="download-title">Your next world<br/> <span>starts here.</span></h2><p>Free for Windows, macOS, and Linux. Pick your platform.</p></header><PlatformDownloads data={downloads}/><p class="release-data-note"><a href={downloads.releaseUrl} data-release-link><span data-release-version>{downloads.version?`v${downloads.version}`:'Latest release'}</span> release notes <ArrowUpRight size={13}/></a></p><p class="release-data-note" data-release-status>Release data checked {new Date(downloads.fetchedAt).toLocaleDateString('en-US',{timeZone:'UTC',month:'short',day:'numeric',year:'numeric'})}. <a href={site.repository+'/releases'}>All GitHub releases</a></p></section>
  <section class="faq-section container" aria-labelledby="faq-title"><header class="panel-heading"><h2 id="faq-title">Before you <span>download.</span></h2></header><div class="faq-list">{questions.map(([question,answer])=><details><summary>{question}<ChevronDown size={18}/></summary><p>{answer}</p></details>)}</div><a class="text-link" href="/wiki/">More answers in the Wiki <ArrowRight size={16}/></a></section>
  <div class="closing-wordmark container" aria-hidden="true">REFRACT<span>LET’S PLAY.</span></div>
</BaseLayout>
<script>
  import { refreshHomepage } from "@/scripts/homepage";
  refreshHomepage();
  const reveal=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('arrived');reveal.unobserve(entry.target);}}),{threshold:.08});
  document.querySelectorAll('.game-panel,.utility-card').forEach(element=>{element.classList.add('will-reveal');reveal.observe(element);});
</script>
