---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { getPeople } from "@/data/people";
import { site } from "@/data/site";
const people = await getPeople();
---
<BaseLayout title="About" description="The people, principles, and open-source foundation behind Refract." editPath="src/pages/about/index.astro">
  <PageHero eyebrow="About Refract" title="A launcher that keeps the whole library together." description="Refract is built for players who want control without turning setup into a second hobby. It combines native performance with a focused interface and public, inspectable source code." />
  <section class="narrow about-grid">
    <article class="surface prose story">
      <h2>What is Refract?</h2><p>{site.description}</p>
      <p>Its instances isolate content and data, while the surrounding tools keep imports, runtimes, accounts, worlds, servers, screenshots, logs, and updates in context.</p>
      <h2>Project philosophy</h2><p>Refract favors direct control, useful defaults, reversible actions, and honest status. The application should explain what it is doing, preserve player data through updates, and stay useful without forcing browser hopping.</p>
      <h2>From Electron to Tauri</h2><p>The project began with an Electron shell and moved to Tauri in version 1.2. The React renderer remains, while Rust now handles the native backend, downloads, file operations, secure credential storage, launching, and platform integration.</p>
    </article>
    <aside class="surface facts"><h2>At a glance</h2><dl><div><dt>Current release</dt><dd>{site.release.version}</dd></div><div><dt>License</dt><dd>{site.license}</dd></div><div><dt>Platforms</dt><dd>Windows, macOS, Linux</dd></div><div><dt>Core</dt><dd>Tauri, Rust, React, TypeScript</dd></div><div><dt>Content</dt><dd>Modrinth, CurseForge, FTB</dd></div></dl></aside>
  </section>
  <section class="section people-section"><div class="narrow"><div class="section-head"><span class="eyebrow">Maintainers & contributors</span><h2>The people in the commit history.</h2><p>Contributor data updates automatically from the public Refract repository.</p></div><div class="people-grid">{people.map((person) => <a class="person surface" href={person.href} target="_blank" rel="noreferrer"><img src={person.avatar} alt={`${person.name}'s GitHub avatar`} width="96" height="96" loading="lazy" referrerpolicy="no-referrer" /><div><span>{person.label}</span><h3>{person.name}</h3><p>{person.role} - @{person.handle}</p></div></a>)}</div></div></section>
</BaseLayout>
<style>
  .about-grid { padding-bottom: 5rem; display: grid; grid-template-columns: 1fr 20rem; gap: 1rem; align-items: start; }
  .story, .facts { padding: clamp(1.4rem, 4vw, 2.5rem); }
  .story h2:first-child, .facts h2 { margin-top: 0; }
  .facts { position: sticky; top: 6rem; }
  dl { margin: 0; }
  dl div { padding-block: .8rem; border-bottom: 1px solid var(--border); }
  dt { color: var(--subtle); font: .7rem/1.4 var(--mono); text-transform: uppercase; }
  dd { margin: .25rem 0 0; font-weight: 800; }
  .people-section { border-top: 1px solid var(--border); background: rgba(9,9,13,.48); }
  .people-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; }
  .person { padding: 1rem; display: flex; align-items: center; gap: 1rem; transition: border-color .15s ease, transform .15s ease; }
  .person:hover, .person:focus-visible { transform: translateY(-2px); border-color: var(--primary); }
  .person img { width: 4.5rem; height: 4.5rem; border-radius: var(--radius); }
  .person span { color: var(--primary-bright); font: .65rem/1 var(--mono); text-transform: uppercase; }
  .person h3 { margin: .35rem 0 .2rem; }
  .person p { margin: 0; font-size: .82rem; }
  @media (max-width: 52rem) { .about-grid { grid-template-columns: 1fr; } .facts { position: static; } }
  @media (max-width: 38rem) { .people-grid { grid-template-columns: 1fr; } }
</style>
