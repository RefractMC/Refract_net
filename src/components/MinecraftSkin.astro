---
import { Pause, Play, RotateCcw, Upload, Layers, Footprints, MoveHorizontal } from "@/components/icons";
---
<minecraft-skin data-skin="/images/skins/clavnerok.png" data-model="default" aria-label="Interactive Minecraft skin preview">
  <div class="skin-stage">
    <canvas tabindex="0" role="img" aria-label="Clavnerok’s Minecraft skin. Drag or use left and right arrow keys to rotate."></canvas>
    <div class="skin-loading" role="status">Loading Clavnerok’s skin…</div>
    <div class="skin-stage-controls" hidden>
      <span><MoveHorizontal size={18}/> Drag to rotate</span>
      <button type="button" data-reset-view aria-label="Reset skin rotation"><RotateCcw size={18}/></button>
      <button type="button" data-pause aria-label="Pause skin animation" aria-pressed="false"><Pause class="pause-icon" size={18}/><Play class="play-icon" size={18}/></button>
    </div>
  </div>
  <div class="skin-toolbar" hidden>
    <div class="skin-identity"><strong data-skin-name>Clavnerok</strong><span> Minecraft skin</span><button class="restore-skin" type="button" data-restore hidden>Restore</button></div>
    <div class="skin-options">
      <label class="skin-upload"><Upload size={18}/><span>Try your skin</span><input type="file" accept="image/png,.png" aria-label="Choose a Minecraft skin PNG"/></label>
      <button type="button" data-layers aria-label="Show outer skin layer" aria-pressed="true"><Layers size={18}/><span>Outer layer</span></button>
      <button type="button" data-walk aria-label="Walking animation" aria-pressed="false"><Footprints size={18}/><span>Walk</span></button>
      <select data-model-select aria-label="Skin arm model"><option value="auto-detect">Auto arms</option><option value="default" selected>Classic arms</option><option value="slim">Slim arms</option></select>
    </div>
    <p class="skin-note" data-skin-status role="status">PNG skins stay in your browser.</p>
  </div>
</minecraft-skin>
<script>import "@/scripts/minecraft-skin";</script>
<style>
  minecraft-skin { display:flex; flex-direction:column; position:relative; height:100%; min-height:380px; min-width:0; }
  .skin-stage { flex:1; min-height:0; position:relative; }
  canvas { display:block; position:absolute; inset:0; width:100%; height:100%; cursor:grab; touch-action:pan-y; }
  canvas:active { cursor:grabbing; }
  .skin-loading { position:absolute; inset:0; display:grid; place-items:center; padding:30px; text-align:center; font-size:13px; color:#ffe9ce; }
  .skin-stage-controls { position:absolute; bottom:6px; right:0; left:0; display:flex; align-items:center; justify-content:center; gap:8px; }
  .skin-stage-controls>span { display:flex; align-items:center; gap:6px; margin-right:6px; font-size:12px; color:#ffdfec; }
  button,select,.skin-upload { border:1px solid #f7c3dc66; background:#501b3c; color:#ffe8f2; font:600 12px var(--font); min-height:44px; display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:8px 10px; }
  button:hover,select:hover,.skin-upload:hover { background:#692448; }
  button[aria-pressed="true"] { border-color:#ffe1a0; color:#ffe1a0; background:#3d1730; box-shadow:inset 0 -3px #ffe1a0; }
  .skin-stage-controls button { width:44px; padding:8px; }
  .play-icon, [aria-pressed="true"] .pause-icon { display:none; }
  [aria-pressed="true"] .play-icon { display:block; }
  .skin-toolbar { padding-top:8px; text-align:center; }
  .skin-identity { margin:0 0 9px; font-size:12px; color:#efc8da; }
  .skin-identity strong { color:#ffe5a0; font-weight:700; }
  .restore-skin { min-height:44px; padding:2px 6px; margin-left:8px; }
  .skin-options { display:flex; justify-content:center; flex-wrap:wrap; gap:6px; }
  .skin-upload { position:relative; cursor:pointer; }
  .skin-upload input { position:absolute; inset:0; opacity:0; width:100%; cursor:pointer; }
  .skin-upload:focus-within { outline:2px solid #ffe5a0; outline-offset:3px; }
  .skin-note { color:#e4b8ce; font-size:11px; line-height:1.5; margin:8px 0 0; min-height:13px; }
  .skin-note[data-error="true"] { color:#ffedab; }
  @media(prefers-reduced-motion:reduce) { [data-pause],[data-walk] { display:none; } }
  @media(max-width:450px) { .skin-options { gap:4px; } button,select,.skin-upload { padding-inline:8px; font-size:11px; } }
</style>
