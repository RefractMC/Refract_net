---
import { ArrowRight, Check } from "@/components/icons";
import FeaturePreview from "./FeaturePreview.astro";
interface Props {
  title: string; description: string; image: "library" | "browse" | "settings";
  alt: string; href: string; linkLabel: string; points: string[]; reverse?: boolean; tour?: "modpacks" | "library" | "browse" | "settings";
}
const { title, description, image, alt, href, linkLabel, points, reverse = false, tour = image } = Astro.props;
---
<article class:list={["product-feature", { reverse }]}>
  <div class="feature-copy">
    <h3>{title}</h3>
    <p>{description}</p>
    <ul>{points.map(point => <li><Check size={17} aria-hidden="true" />{point}</li>)}</ul>
    <a class="text-link" href={href}>{linkLabel}<ArrowRight size={16} /></a>
  </div>
  <FeaturePreview image={image} alt={alt} tour={tour} />
</article>
<style>
  .product-feature { display: grid; grid-template-columns: .85fr 1.25fr; align-items: center; gap: clamp(2rem, 6vw, 5.5rem); padding-block: 3.5rem; }
  .feature-copy { max-width: 29rem; }
  h3 { font-size: clamp(1.7rem, 2.7vw, 2.35rem); margin-bottom: 1.1rem; letter-spacing: -.035em; }
  p { font-size: .98rem; line-height: 1.8; margin-bottom: 1.4rem; }
  ul { display: grid; gap: .7rem; list-style: none; padding: 0; margin-bottom: 1.8rem; }
  li { display: flex; align-items: start; gap: .7rem; color: var(--muted); font-size: .88rem; }
  li svg { color: var(--primary-bright); margin-top: .2rem; }
  .reverse { grid-template-columns: 1.25fr .85fr; }
  .reverse .feature-copy { order: 2; }
  @media (max-width: 767px) { .product-feature, .reverse { grid-template-columns: 1fr; gap: 1.8rem; padding-block: 2.3rem; } .reverse .feature-copy { order: 0; } .feature-copy { max-width: none; } }
</style>
