---
import { Pause, Play } from "@/components/icons";
---
<flying-fox aria-label="A blocky fox flying in a wooden boat">
  <canvas aria-hidden="true"></canvas>
  <button type="button" aria-label="Pause fox animation" aria-pressed="false" hidden><Pause class="pause-icon" size={13} /><Play class="play-icon" size={13} /><span>Pause fox</span></button>
</flying-fox>
<script>
  import "@/scripts/flying-fox";
</script>
<style>
  flying-fox { display: block; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  canvas { position: absolute; inset: 0; z-index: 0; display: block; width: 100%; height: 100%; pointer-events: none; }
  button { position: absolute; z-index: 2; right: 5px; bottom: 0; display: inline-flex; align-items: center; gap: .4rem; min-height: 32px; padding: .3rem .5rem; border: 0; background: transparent; color: var(--subtle); font: inherit; font-size: .68rem; cursor: pointer; pointer-events: auto; }
  button:hover { color: var(--primary-bright); }
  button[hidden] { display: none; }
  .play-icon, button[aria-pressed="true"] .pause-icon { display: none; }
  button[aria-pressed="true"] .play-icon { display: block; }
  @media (max-width: 767px) { button { bottom: 22px; right: 0; } }
  @media (prefers-reduced-motion: reduce) { button { display: none; } }
</style>
