---
import { ArrowUpRight, Pause, Play } from '@/components/icons';
const projects = [
  { slug: 'iris', name: 'Iris Shaders', type: 'mod', label: 'Shaders', photo: true, description: 'A shader-lit Minecraft landscape from the Iris gallery' },
  { slug: 'sodium', name: 'Sodium', type: 'mod', label: 'Performance' },
  { slug: 'continuity', name: 'Continuity', type: 'mod', label: 'Connected textures' },
  { slug: 'fresh-animations', name: 'Fresh Animations', type: 'resourcepack', label: 'Resource pack' },
  { slug: 'faithful-32x', name: 'Faithful 32x', type: 'resourcepack', label: '32× textures' },
  { slug: 'bare-bones', name: 'Bare Bones', type: 'resourcepack', label: 'Resource pack', photo: true, description: 'Minecraft copper blocks with Bare Bones textures' },
];
---
<div class="modrinth-cloud" data-modrinth-cloud data-still="true">
  <header class="cloud-heading">
    <p class="cloud-eyebrow">A FEW COMMUNITY FAVORITES</p>
    <h2 id="features-title">Less setup.<br/><span>More Minecraft.</span></h2>
    <p>New textures. Better performance.<br/>A whole new world to get lost in.</p>
    <div class="cloud-types" aria-label="Supported content"><span>Mods</span><span>Modpacks</span><span>Shaders</span><span>Textures</span></div>
  </header>
  <div class="cloud-art" aria-label="Explore featured projects on Modrinth">
    {projects.map((project, index) => <a class:list={['floating-project', project.slug, { 'landscape-project': project.photo }]} href={`https://modrinth.com/${project.type}/${project.slug}`} style={`--delay:-${index * 1.3}s;--duration:${6 + index % 3}s`} aria-label={`${project.name} on Modrinth`}>
      <img src={`/images/modrinth/${project.slug}.webp`} width={project.photo ? 350 : 128} height={project.photo ? 197 : 128} alt={project.description ?? ''} loading="lazy" decoding="async"/>
      <span class="project-caption"><strong>{project.name}</strong><small>{project.label}</small></span>
      <ArrowUpRight size={15}/>
    </a>)}
  </div>
  <div class="cloud-footer"><p>Artwork from <a href="https://modrinth.com/">Modrinth</a> · made by the community</p><button type="button" data-cloud-toggle aria-label="Pause floating artwork" aria-pressed="false"><span data-pause><Pause size={17}/></span><span data-play hidden><Play size={17}/></span></button></div>
</div>
<style>
  .modrinth-cloud{position:relative;isolation:isolate;min-height:440px;margin:-12px 0 36px}
  .cloud-heading{position:relative;z-index:2;text-align:center;width:55%;margin:auto;padding-top:80px;pointer-events:none}
  .cloud-eyebrow{font-family:var(--font-mono);font-size:10px!important;letter-spacing:.15em;color:#d9e9bc!important;margin:0 0 17px!important}
  .cloud-heading h2{font-size:clamp(2.25rem,4.2vw,3.6rem);line-height:1.04;letter-spacing:-.055em;margin:0 0 20px;font-weight:850}
  .cloud-heading h2 span{color:#ffe6a0}
  .cloud-heading p{font-size:14px;line-height:1.65;color:#edf1e1;margin:0}
  .cloud-types{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:22px}
  .cloud-types span{font-size:10px;padding:5px 8px;border:1px solid #ffffff38;border-radius:4px;color:#f2f5e8}
  .floating-project{position:absolute;display:flex;align-items:center;gap:10px;color:#fff9e6;text-decoration:none;background:#253e26;border:1px solid #b2cc8170;border-radius:9px;padding:10px;box-shadow:0 8px 0 #17271840,0 18px 24px #17271825;animation:project-float var(--duration) ease-in-out var(--delay) infinite alternate;transform:rotate(var(--tilt));will-change:transform;z-index:1}
  .floating-project img{width:48px;height:48px;object-fit:cover;border-radius:6px;flex-shrink:0}
  .floating-project strong{font-size:12px;line-height:1.3;display:block;font-weight:700}
  .floating-project small{display:block;font-size:10px;color:#cfdfbc;margin-top:4px}
  .floating-project :global(svg){margin-left:auto;opacity:.65;flex-shrink:0}
  .floating-project:hover,.floating-project:focus-visible{z-index:3;border-color:#ffe6a0;background:#304b2d;animation-play-state:paused}
  .landscape-project{display:grid;grid-template-columns:1fr auto;gap:9px;width:210px;padding:7px 7px 11px}
  .landscape-project img{grid-column:1/-1;width:100%;height:112px;border-radius:4px}
  .landscape-project .project-caption{padding-left:4px}
  .landscape-project :global(svg){margin-right:4px}
  .iris{left:0;top:27px;--tilt:-8deg}
  .sodium{right:10px;top:11px;--tilt:7deg}
  .continuity{left:15px;top:267px;--tilt:5deg}
  .fresh-animations{right:0;top:112px;--tilt:-5deg}
  .faithful-32x{left:28%;top:375px;--tilt:-5deg}
  .bare-bones{right:18px;top:240px;--tilt:7deg}
  .cloud-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:140px}
  .cloud-footer p{font-size:10px;color:#d0dfbd;margin:0}
  .cloud-footer a{color:inherit;text-underline-offset:3px}
  .cloud-footer button{width:44px;height:44px;display:grid;place-items:center;color:#edf1e1;border:1px solid #ffffff35;background:#243c2450;border-radius:6px}
  .cloud-footer button:hover{background:#243c24}
  .cloud-footer [hidden]{display:none}
  [data-still="true"] .floating-project{animation-play-state:paused}
  @keyframes project-float{from{transform:translateY(0) rotate(var(--tilt))}to{transform:translateY(-12px) rotate(calc(var(--tilt) + 3deg))}}
  @media(max-width:1000px) and (min-width:701px){.landscape-project{width:165px}.landscape-project img{height:92px}.floating-project{gap:6px}.floating-project img:not(.landscape-project img){width:35px;height:35px}.floating-project strong{font-size:10px}.floating-project small{font-size:9px}.cloud-heading{width:53%}.cloud-heading h2{font-size:36px}.cloud-types{max-width:220px;margin:20px auto 0}.faithful-32x{left:30%}}
  @media(max-width:700px){.modrinth-cloud{margin:0 0 30px;min-height:0}.cloud-heading{width:100%;padding:0 0 32px}.cloud-heading h2{font-size:40px}.cloud-eyebrow{font-size:8px!important}.cloud-art{display:grid;grid-template-columns:1fr 1fr;gap:19px 14px;padding:0 4px}.floating-project{position:relative;inset:auto;min-width:0;width:auto;padding:8px;gap:7px}.floating-project img{width:35px;height:35px}.floating-project strong{font-size:10px}.floating-project small{font-size:8px}.floating-project :global(svg){display:none}.landscape-project{grid-column:1/-1;display:grid;grid-template-columns:90px 1fr;gap:12px}.landscape-project img{grid-column:auto;width:90px;height:58px}.landscape-project strong{font-size:12px}.landscape-project small{font-size:10px}.iris{--tilt:-3deg}.bare-bones{--tilt:3deg}.cloud-heading + .cloud-art + .cloud-footer{padding-top:24px}.cloud-footer p{max-width:220px;line-height:1.6}.cloud-footer button{flex-shrink:0}}
  @media(prefers-reduced-motion:reduce){.floating-project{animation:none;will-change:auto}.cloud-footer button{display:none}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-modrinth-cloud]').forEach(cloud => {
    const button = cloud.querySelector<HTMLButtonElement>('[data-cloud-toggle]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    let visible = false;
    const update = () => { cloud.dataset.still = String(paused || !visible || document.hidden || reduced.matches); };
    button.addEventListener('click', () => {
      paused = !paused;
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', paused ? 'Resume floating artwork' : 'Pause floating artwork');
      button.querySelector<HTMLElement>('[data-pause]')!.hidden = paused;
      button.querySelector<HTMLElement>('[data-play]')!.hidden = !paused;
      update();
    });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }).observe(cloud);
    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
  });
</script>
