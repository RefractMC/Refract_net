---
interface Props { eyebrow?: string; title: string; description: string; compact?: boolean; }
const { eyebrow, title, description, compact = false } = Astro.props;
---
<section class:list={["page-hero", { compact }]}><div class="narrow">{eyebrow && <span class="eyebrow">{eyebrow}</span>}<h1>{title}</h1><p>{description}</p><slot /></div></section>
<style>
  .page-hero { padding-block: clamp(3.5rem, 7vw, 6rem) 3rem; }
  .page-hero.compact { padding-block: 4rem 2.5rem; }
  h1 { max-width: 20ch; margin: 1rem 0 1.25rem; font-size: clamp(2.5rem, 5vw, 4rem); }
  p { max-width: 60ch; margin: 0; font-size: 1.05rem; }
  @media (max-width: 40rem) { .page-hero, .page-hero.compact { padding-block: 3rem 2rem; } }
</style>
