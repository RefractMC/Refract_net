---
import { ArrowDownToLine } from "@/components/icons";
import type { DownloadItem } from "@/data/downloads";
const { items } = Astro.props as { items: DownloadItem[] };
---
<div class="downloads">{items.map(item => <article class="download-card surface"><div><h2>{item.name}</h2><p>{item.detail}{item.size ? " · " + item.size : ""}</p></div><a class="button button-primary" href={item.href} aria-label={"Download " + item.name + " " + item.format + " " + item.architecture}><ArrowDownToLine size={16} />Download {item.format}</a></article>)}</div>
<style>
  .downloads { display: grid; gap: .8rem; margin-block: 1.4rem 2rem; }
  .download-card { padding: 1.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .download-card h2 { margin: 0 0 .5rem; font-size: 1.2rem; }
  .download-card p { margin: 0; font: .77rem/1.5 var(--mono); }
  @media(max-width: 36rem) { .download-card { align-items: stretch; flex-direction: column; } }
</style>
